# ── Gateway Settings ─────────────────────────────────────────────────────────
GATEWAY_PORT=3000
FASTAPI_ORIGIN=http://localhost:8000

# ── Tarpit (SQL-injection stall engine) ──────────────────────────────────────
# Max concurrent attacker connections held open
TARPIT_MAX_SOCKETS=10
# How long (ms) to stall an attacker before ending the connection
TARPIT_TIMEOUT_MS=30000
# How often (ms) to trickle 1 byte to keep the attacker waiting
TARPIT_TRICKLE_INTERVAL_MS=4000

# ── Velocity Breaker (rate limiter) ──────────────────────────────────────────
# Sliding window (ms) to count requests per IP
VELOCITY_WINDOW_MS=3000
# Max requests allowed inside the window before lockout
VELOCITY_MAX_CALLS=3
# How long (ms) a locked IP is blocked
VELOCITY_LOCKOUT_MS=60000

# ── Crypto Service (AES-256-GCM) ─────────────────────────────────────────────
# Must be at least 32 random characters — CHANGE THIS before going to production
MASTER_SECRET=change-this-to-a-random-secret-min-32-chars
